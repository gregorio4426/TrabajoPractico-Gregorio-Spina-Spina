# Copiar a .env (ignorado por Git) y completar localmente. No usar valores de prueba.
GYM_DB_URL=jdbc:mysql://localhost:3306/APPgimnasioBD
GYM_DB_USERNAME=
GYM_DB_PASSWORD=
# Generar al menos 32 bytes aleatorios con un gestor de secretos u openssl.
GYM_JWT_SECRET_BASE64=
GYM_JWT_TTL=PT24H
GYM_JWT_ISSUER=gimnasio-api
GYM_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Activar únicamente para crear el primer ADMIN; retirar sus credenciales después.
GYM_BOOTSTRAP_ADMIN_ENABLED=false
GYM_BOOTSTRAP_ADMIN_EMAIL=
GYM_BOOTSTRAP_ADMIN_PASSWORD=
