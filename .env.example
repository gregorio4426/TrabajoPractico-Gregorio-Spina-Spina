MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
GYM_JWT_SECRET_BASE64=
GYM_BOOTSTRAP_ADMIN_ENABLED=true
GYM_BOOTSTRAP_ADMIN_EMAIL=
GYM_BOOTSTRAP_ADMIN_PASSWORD=
GYM_BIND_ADDRESS=127.0.0.1
